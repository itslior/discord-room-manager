# Discord Bot Configuration
# Required: Get from Discord Developer Portal (https://discord.com/developers/applications)

# Bot token for authentication
DISCORD_BOT_TOKEN=your_bot_token_here

# Application ID (Client ID) for command registration
APPLICATION_ID=your_application_id_here

# Public key (optional, only needed for webhook interactions)
# PUBLIC_KEY=your_public_key_here

# Optional: Comma-separated list of guild IDs to restrict bot operation
# Leave empty to allow all guilds where the bot is installed
# ALLOWED_GUILD_IDS=123456789012345678,987654321098765432
